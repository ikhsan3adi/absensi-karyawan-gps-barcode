# Local development stack: complete container environment.
# Safe to commit: dummy values and a throwaway APP_KEY, never reuse
# outside localhost. Laravel boots purely from these variables; no
# .env file is mounted into the container.

APP_NAME="Absensi Karyawan"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
ASSET_URL=http://localhost:8000

# Shared dev key; regenerate locally if you handle sensitive data
APP_KEY=base64:hUejgb9evLXKQSrcUXYi9pzzccEnNcODQPR5oDiYBR8=

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
DEVICE_RESTRICTION_ENABLED=true

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db_absensi_karyawan
DB_USERNAME=root
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MYSQL_DATABASE=db_absensi_karyawan
MYSQL_ROOT_PASSWORD=secret

PMA_HOST=db
PMA_PORT=3306
PMA_USER=root
PMA_PASSWORD=secret
UPLOAD_LIMIT=20M